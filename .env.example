# ---------------------------------------------------------------------------
# Taher Caps — environment variables
#
# Copy to `.env` for local development and set the same values in the Vercel
# project for deployment. `.env` is gitignored; never commit it.
#
# The rule for the VITE_ prefix: anything prefixed VITE_ is compiled into the
# browser bundle and is therefore PUBLIC. Anything without it stays on the
# server. Adding VITE_ to a secret below would publish that secret.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project URL and publishable key. Both are public by design: they ship in the
# browser bundle, and every table they can reach is guarded by row-level
# security. Project Settings -> API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase service role (required, SERVER ONLY) -------------------------
# Full database access, bypassing row-level security. Used by the checkout,
# the tracking lookup and the Paymob webhook to call the security-definer
# functions no browser role may execute.
#
# NEVER prefix this with VITE_. Never commit it. Rotate it if it is ever
# pasted anywhere it should not have been.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (required) -------------------------------------------------------
# The public origin. Used to build the URLs Paymob redirects the customer back
# to and posts its webhook to, so it must be the real deployed origin in
# production, not localhost.
VITE_SITE_URL=http://localhost:8080

# --- Paymob (required for online payment, SERVER ONLY) ---------------------
#
# Names below match Paymob's current Unified Intention flow. Confirm each one
# against the live dashboard and the current documentation before going live
# — see docs/PAYMOB.md. Leave them all blank to run the shop with cash on
# delivery only: the checkout detects that and does not offer online payment.
#
# Dashboard -> Settings -> API Keys. Sent as `Authorization: Token <key>`.
PAYMOB_SECRET_KEY=
# Dashboard -> Settings -> API Keys. Used in the checkout URL, so it is
# visible to the customer's browser by design — but it is only ever put there
# by the server, and it grants nothing on its own.
PAYMOB_PUBLIC_KEY=
# Dashboard -> Developers -> Payment Integrations. The numeric id of the card
# integration to charge through.
PAYMOB_INTEGRATION_ID_CARD=
# Dashboard -> Settings -> Account Info -> HMAC. This is what makes a webhook
# trustworthy; without it the webhook refuses every callback rather than
# accepting an unverified one.
PAYMOB_HMAC_SECRET=

# Optional. Override only if Paymob moves its host or you are integrating in a
# region other than Egypt (Saudi Arabia, the UAE, Oman and Pakistan each have
# their own base URL).
# PAYMOB_API_BASE=https://accept.paymob.com
# PAYMOB_CHECKOUT_URL=https://accept.paymob.com/unifiedcheckout/

# --- New-order notifications (optional) ------------------------------------
# An email the moment an order is placed. Leave blank and the shop simply does
# not notify -- orders still arrive, you just have to look at /admin.
#
# Setup, about five minutes:
#   1. Sign up free at resend.com (3,000 emails a month, no card).
#   2. API Keys -> Create API Key -> copy it into RESEND_API_KEY below.
#   3. Put the address that should receive orders in ORDER_NOTIFICATION_EMAIL.
#      Several addresses, separated by commas, all work.
#
# IMPORTANT while you have no domain: Resend's sandbox sender can only deliver
# to the email address that owns the Resend account. So sign up with the
# address you want the orders to reach. Once a domain exists, verify it in
# Resend and set RESEND_FROM below -- then mail reaches anybody.
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
# Only once a domain is verified with Resend. Until then leave it blank and
# the sandbox sender is used.
# RESEND_FROM=Taher's Merch <orders@yourdomain.com>

# Optional second channel, if anybody prefers a chat message. Both fire if
# both are set. @BotFather gives you the token; the chat id comes from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Build (optional) ------------------------------------------------------
# Nitro deployment preset. Defaults to vercel; set this to build for another
# target.
# NITRO_PRESET=vercel
